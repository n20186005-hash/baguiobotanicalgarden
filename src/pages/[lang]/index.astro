---
import {
  SITE, ENTITY, REVIEW_META, REVIEWS, SOURCES,
  KEY_INFO, ATTRACTIONS, PRACTICAL_INFO, TRANSPORT_METHODS,
  FAQS, TIPS, GALLERY_IMAGES, NEARBY, HISTORY_TIMELINE, LEGENDS,
  DISCLAIMER_FIL, DISCLAIMER_EN,
} from '../../consts';
import { ui, getLangFromUrl, type Lang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WeatherWidget from '../../components/WeatherWidget.astro';
import SeasonStrategySection from '../../components/sections/SeasonStrategySection.astro';
import AudienceRoutesSection from '../../components/sections/AudienceRoutesSection.astro';
import ItinerariesSection from '../../components/sections/ItinerariesSection.astro';
import VisitorServicesSection from '../../components/sections/VisitorServicesSection.astro';
import TransportExtraSection from '../../components/sections/TransportExtraSection.astro';
import ScienceSection from '../../components/sections/ScienceSection.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'tl' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params as { lang: string };
const currentLang = lang as Lang;

const currentUrl = new URL(Astro.url);
const t = (key: string) => ui[currentLang]?.[key as keyof typeof ui.tl] ?? key;

const isEn = currentLang === 'en';
const title = isEn ? SITE.titleEn : SITE.titleFil;
const description = isEn ? SITE.descriptionEn : SITE.descriptionFil;
const ogTitle = isEn ? SITE.ogTitleEn : SITE.ogTitleFil;
const ogDescription = isEn ? SITE.ogDescriptionEn : SITE.ogDescriptionFil;
const ogImage = `${SITE.siteUrl}${SITE.heroImage}`;

const countryName = isEn ? ENTITY.country : ENTITY.countryFil;
const cityName = ENTITY.city;
const shortName = ENTITY.shortName;
const fullName = ENTITY.fullName;

const reviewsTitle = isEn ? 'Google Maps Reviews' : 'Mga Review mula sa Google Maps';
const reviewsSourceText = isEn
  ? 'Rating and review count synced from Google Maps (Google Maps) user reviews · September 2026 · View all Google Maps reviews↗'
  : 'Rating at bilang ng review na nakasabay sa mga review ng gumagamit ng Google Maps (Google Maps) · Setyembre 2026 · Tingnan ang lahat ng review sa Google Maps↗';
const reviewsNote = isEn
  ? 'Synced from Google Maps user reviews, synced September 2026; copyright belongs to the original authors and Google Maps.'
  : 'Nakasabay sa mga review ng gumagamit ng Google Maps, petsa ng pag-sync: Setyembre 2026; ang karapatang-ari ay nananatili sa orihinal na may-akda at sa Google Maps.';
const reviewsCta = isEn ? 'View all reviews on Google Maps' : 'Tingnan ang lahat ng review sa Google Maps';
const reviewsFromLabel = isEn ? 'Google Maps user review' : 'Review ng gumagamit ng Google Maps';
const sourcesTitle = isEn ? 'Sources & References' : 'Mga Pinagmumulan ng Impormasyon';
const sourcesIntro = isEn
  ? 'The content of this page is drawn from public and official references. Below is the full list of sources, sync dates, and copyright notices.'
  : 'Ang nilalaman ng pahinang ito ay nagmula sa mga pampubliko at opisyal na sanggunian. Nasa ibaba ang kumpletong listahan ng mga pinagmumulan, petsa ng pag-sync, at mga paunawa sa karapatang-ari.';

const breadcrumbItems = [
  { label: isEn ? 'Home' : 'Home', href: `/${currentLang}/` },
  { label: countryName, href: null },
  { label: ENTITY.province, href: null },
  { label: ENTITY.cityLong, href: null },
  { label: fullName, href: null },
];
---

<BaseLayout
  title={title}
  description={description}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  lang={currentLang}
  faqs={FAQS}
>
  <!-- ======= HERO SECTION ======= -->
  <section class="relative min-h-[85vh] sm:min-h-screen flex items-center justify-center overflow-hidden">
    <!-- Background with gradient overlay -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style="background-image: url('/gallery/baguio-botanical-garden-1.jpg');"
    ></div>
    <div class="absolute inset-0 hero-overlay"></div>

    <!-- Content -->
    <div class="relative z-10 container-page text-center text-white py-20">
      <div class="animate-fade-in space-y-5 max-w-3xl mx-auto">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white/15 backdrop-blur-sm px-4 py-1.5 text-xs sm:text-sm font-medium text-white/90 border border-white/20">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/></svg>
          {currentLang === 'en' ? 'Baguio City, Philippines' : 'Lungsod ng Baguio, Pilipinas'}
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold tracking-tight leading-[1.1] drop-shadow-lg">
          {`${fullName} (${cityName})`}
        </h1>
        <p class="text-lg sm:text-xl lg:text-2xl text-white/85 max-w-2xl mx-auto font-normal drop-shadow">
          {currentLang === 'en'
            ? 'Explore themed gardens from around the world, discover Igorot culture, and immerse yourself in Cordillera\'s rich biodiversity.'
            : 'Tuklasin ang mga themed garden mula sa iba\'t ibang bansa, alamin ang kultura ng Igorot, at namnamin ang mayamang biodiversity ng Cordillera.'}
        </p>

        <!-- Stats micro row -->
        <div class="flex flex-wrap items-center justify-center gap-6 pt-2 text-sm text-white/80">
          <span class="inline-flex items-center gap-1.5">
            <svg class="h-4 w-4 text-rose-sand-300" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            {REVIEW_META.rating} ({isEn
              ? `${REVIEW_META.reviewCountLabel} reviews`
              : `${REVIEW_META.reviewCountLabel} na review`})
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg class="h-4 w-4 text-rose-sand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            {currentLang === 'en' ? '6:00 AM – 6:00 PM' : '6:00 AM – 6:00 PM'}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg class="h-4 w-4 text-rose-sand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a8 8 0 00-8 8c0 6 8 12 8 12s8-6 8-12a8 8 0 00-8-8z"/><circle cx="12" cy="10" r="3"/></svg>
            {isEn ? 'Baguio, Benguet' : 'Baguio, Benguet'}
          </span>
        </div>

        <!-- Rating & review source attribution -->
        <p class="pt-1 text-[11px] sm:text-xs text-white/75">
          <a
            href={REVIEW_META.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="underline decoration-white/40 underline-offset-2 hover:text-white transition-colors"
          >
            {reviewsSourceText}
          </a>
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-3 pt-4">
          <a href="#about" class="inline-flex items-center gap-2 rounded-xl bg-rose-sand-500 hover:bg-rose-sand-600 px-6 py-3 text-sm sm:text-base font-semibold text-white shadow-lg shadow-rose-sand-500/30 transition-all duration-300 hover:shadow-xl hover:shadow-rose-sand-500/40 hover:-translate-y-0.5">
            {currentLang === 'en' ? 'Explore the Garden' : 'Tuklasin ang Hardin'}
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
          </a>
          <a
            href={SITE.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-white/15 backdrop-blur-sm hover:bg-white/25 border border-white/25 px-6 py-3 text-sm sm:text-base font-semibold text-white transition-all duration-300 hover:-translate-y-0.5"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 2a8 8 0 00-8 8c0 4.5 8 12 8 12s8-7.5 8-12a8 8 0 00-8-8z"/><circle cx="12" cy="10" r="3"/></svg>
            {currentLang === 'en' ? 'View on Google Maps' : 'Tingnan sa Google Maps'}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ======= BREADCRUMB / ENTITY HIERARCHY ======= -->
  <nav aria-label="Breadcrumb" class="bg-cold-50 border-b border-cold-100">
    <div class="container-page py-3">
      <ol class="flex flex-wrap items-center gap-1.5 text-xs text-cold-500">
        {breadcrumbItems.map((item, i) => (
          <li class="flex items-center gap-1.5">
            {i > 0 && <span aria-hidden="true" class="text-cold-300">/</span>}
            {item.href ? (
              <a href={item.href} class="hover:text-pine-700 transition-colors">{item.label}</a>
            ) : (
              <span class={i === breadcrumbItems.length - 1 ? 'font-semibold text-pine-800' : ''}>{item.label}</span>
            )}
          </li>
        ))}
      </ol>
      <p class="mt-2 text-[11px] text-cold-400">
        {`${fullName} → ${ENTITY.cityLong} → ${ENTITY.province} → ${countryName}`}
      </p>
    </div>
  </nav>

  <!-- ======= KEY INFO CARDS ======= -->
  <section id="key-info" class="section-padding bg-white">
    <div class="container-page">
      <h2 class="section-heading text-center">{currentLang === 'en' ? 'Quick Information' : 'Mabilis na Impormasyon'}</h2>
      <p class="section-subheading text-center mx-auto mb-10">
        {currentLang === 'en' ? 'Everything you need to know before your visit.' : 'Lahat ng kailangan mong malaman bago bumisita.'}
      </p>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        {KEY_INFO.map((item) => (
          <div class="card card-hover p-5 sm:p-6 flex flex-col items-center text-center space-y-3">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-pine-50 text-2xl">
              {item.icon === 'ticket' ? '🎫' : item.icon === 'clock' ? '🕐' : item.icon === 'stopwatch' ? '⏱️' : '💚'}
            </span>
            <div class="space-y-1">
              <p class="text-xs sm:text-sm font-medium text-cold-400 uppercase tracking-wider">
                {currentLang === 'en' ? item.labelEn : item.labelFil}
              </p>
              <p class="text-base sm:text-lg font-bold text-pine-950">
                {currentLang === 'en' ? item.valueEn : item.valueFil}
              </p>
              <p class="text-xs text-cold-500 leading-relaxed">
                {currentLang === 'en' ? item.subEn : item.subFil}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ======= ABOUT SECTION ======= -->
  <section id="about" class="section-padding bg-cold-50">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div class="space-y-5">
          <span class="badge bg-pine-50 text-pine-700 border border-pine-200">
            {currentLang === 'en' ? '🌿 About' : '🌿 Tungkol'}
          </span>
          <h2 class="section-heading">{currentLang === 'en' ? 'About Baguio Botanical Garden' : 'Tungkol sa Baguio Botanical Garden'}</h2>
          <div class="space-y-4 text-cold-600 leading-relaxed">
            {isEn && (
              <p>
                Welcome to <strong class="text-pine-800">{fullName}</strong>, widely recognized as the
                central <strong class="text-pine-800">{shortName}</strong> of {cityName}. Located in
                the heart of <strong>{ENTITY.cityLong}</strong>, <strong>{ENTITY.province}</strong>,
                <strong>{countryName}</strong>, this destination serves as a primary hub for travelers
                visiting the region.
              </p>
            )}
            {!isEn && (
              <p>
                Maligayang pagdating sa <strong class="text-pine-800">{fullName}</strong>, na kilala
                bilang pangunahing <strong class="text-pine-800">{shortName}</strong> ng {cityName}.
                Matatagpuan sa puso ng <strong>{ENTITY.cityLong}</strong>, <strong>{ENTITY.province}</strong>,
                <strong>{countryName}</strong>, ang destinasyong ito ay isa sa mga pangunahing sentro
                ng mga biyahero sa rehiyon.
              </p>
            )}
            <p>{isEn
              ? 'The Baguio Botanical Garden is a 5-hectare public garden located on Leonard Wood Road, Baguio City, Philippines. It is a living showcase of the rich botanical biodiversity of the Cordillera region, international friendship, and indigenous Igorot culture.'
              : 'Ang Baguio Botanical Garden ay isang 5-ektaryang pampublikong hardin na matatagpuan sa Leonard Wood Road, Baguio City, Pilipinas. Ito ay isang living showcase ng mayamang botanikal na biodiversity ng Cordillera region, internasyonal na pagkakaibigan, at katutubong kultura ng Igorot.'}
            </p>
            <p>{currentLang === 'en'
              ? 'The garden features themed gardens representing Chinese, Japanese, Korean, and Philippine native flora, an International Friendship Garden, a Cordillera Village with traditional Igorot huts, and a Sculpture Garden with bronze artworks by Ben Hur Villanueva and local artists.'
              : 'Ang hardin ay nagtatampok ng mga themed garden na kumakatawan sa Chinese, Japanese, Korean, at Philippine native flora, International Friendship Garden, Cordillera Village na may tradisyonal na Igorot huts, at Sculpture Garden na may mga bronze artwork ni Ben Hur Villanueva at iba pang lokal na artist.'}
            </p>
            <p>{currentLang === 'en'
              ? 'Situated at 1,540 meters above sea level, the garden enjoys a cool mountain climate year-round — a perfect escape from the tropical heat. The surrounding pine forests provide crisp mountain air and a serene natural backdrop.'
              : 'Dahil sa mataas na lokasyon nito sa 1,540 metro sa ibabaw ng dagat, ang hardin ay may malamig na klima ng bundok sa buong taon — isang perpektong takas mula sa init ng tropiko. Ang mga pine forest sa paligid ay nagbibigay ng sariwang hanging bundok at tahimik na natural na tanawin.'}
            </p>
          </div>
          <div class="flex flex-wrap gap-3 pt-2">
            <span class="badge bg-rose-sand-50 text-rose-sand-700">
              {currentLang === 'en' ? '🌲 Pine Forest' : '🌲 Pine Forest'}
            </span>
            <span class="badge bg-rose-sand-50 text-rose-sand-700">
              {currentLang === 'en' ? '🏔️ 1,540m Altitude' : '🏔️ 1,540m Altitude'}
            </span>
            <span class="badge bg-rose-sand-50 text-rose-sand-700">
              {currentLang === 'en' ? '🌺 5 Hectares' : '🌺 5 Ektarya'}
            </span>
          </div>
        </div>
        <div class="relative">
          <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-lg">
            <img
              src="/gallery/baguio-botanical-garden-2.jpg"
              alt={`${fullName} - Main view in ${ENTITY.cityLong}, ${countryName}`}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <!-- Decorative element -->
          <div class="absolute -bottom-4 -left-4 w-24 h-24 bg-pine-100 rounded-2xl -z-10 hidden sm:block"></div>
          <div class="absolute -top-4 -right-4 w-20 h-20 bg-rose-sand-200 rounded-2xl -z-10 hidden sm:block"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======= WEATHER & FORECAST ======= -->
  <WeatherWidget lang={currentLang} />

  <!-- ======= HISTORY & LEGENDS SECTION ======= -->
  <section id="history" class="section-padding bg-white">
    <div class="container-page">
      <div class="text-center mb-12">
        <span class="badge bg-rose-sand-50 text-rose-sand-700 border border-rose-sand-200 mb-4">
          {currentLang === 'en' ? '📜 History' : '📜 Kasaysayan'}
        </span>
        <h2 class="section-heading">{isEn ? `History & Significance of ${fullName}` : `Kasaysayan at Kahalagahan ng ${fullName}`}</h2>
        <p class="section-subheading mx-auto">
          {currentLang === 'en'
            ? 'From American colonial nursery to world-class botanical garden — and the folk tales that give meaning to every corner.'
            : 'Mula sa American colonial nursery hanggang sa world-class botanical garden — at ang mga kuwentong bayan na nagbibigay-kahulugan sa bawat sulok.'}
        </p>
      </div>

      <!-- Timeline -->
      <div class="max-w-3xl mx-auto mb-16">
        <div class="space-y-8">
          {HISTORY_TIMELINE.map((period, i) => (
            <div class="relative pl-10 timeline-dot">
              <div class="absolute left-0 top-1 w-6 h-6 rounded-full bg-pine-500 border-4 border-pine-100 flex items-center justify-center">
                <span class="text-white text-[10px] font-bold">{i + 1}</span>
              </div>
              <div class="card card-hover p-5">
                <div class="flex flex-col sm:flex-row sm:items-center gap-2 mb-2">
                  <span class="badge bg-pine-100 text-pine-700 text-xs">
                    {currentLang === 'en' ? period.yearEn : period.yearFil}
                  </span>
                  <h3 class="text-lg font-bold text-pine-950">{currentLang === 'en' ? period.titleEn : period.titleFil}</h3>
                </div>
                <p class="text-cold-600 text-sm leading-relaxed">
                  {currentLang === 'en' ? period.bodyEn : period.bodyFil}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Legends -->
      <div class="max-w-4xl mx-auto">
        <h3 class="text-xl sm:text-2xl font-bold text-pine-950 mb-6 text-center flex items-center justify-center gap-2">
          <span>📖</span>
          {currentLang === 'en' ? 'Legends & Folk Tales' : 'Mga Alamat at Kuwentong Bayan'}
        </h3>
        <p class="section-subheading mx-auto text-center mb-10">
          {currentLang === 'en'
            ? 'The Cordillera region is rich in oral tradition. These stories have been passed down through generations.'
            : 'Ang Cordillera region ay mayaman sa oral tradition. Ang mga kuwentong ito ay naipasa sa maraming henerasyon.'}
        </p>
        <div class="grid sm:grid-cols-2 gap-6">
          {LEGENDS.map((story) => (
            <div class="card card-hover p-6 flex flex-col gap-4">
              <span class="text-4xl">{story.icon}</span>
              <h4 class="text-lg font-bold text-pine-900">
                {currentLang === 'en' ? story.titleEn : story.titleFil}
              </h4>
              <p class="text-sm text-cold-600 leading-relaxed flex-1">
                {currentLang === 'en' ? story.bodyEn : story.bodyFil}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ======= SEASONAL STRATEGY ======= -->
  <SeasonStrategySection lang={currentLang} />

  <!-- ======= ROUTES BY VISITOR TYPE ======= -->
  <AudienceRoutesSection lang={currentLang} />

  <!-- ======= SUGGESTED ITINERARIES ======= -->
  <ItinerariesSection lang={currentLang} />

  <!-- ======= ATTRACTIONS SECTION ======= -->
  <section id="attractions" class="section-padding bg-cold-50">
    <div class="container-page">
      <div class="text-center mb-12">
        <span class="badge bg-pine-50 text-pine-700 border border-pine-200 mb-4">
          {currentLang === 'en' ? '🏯 Attractions' : '🏯 Mga Atraksyon'}
        </span>
        <h2 class="section-heading">{currentLang === 'en' ? 'Themed Gardens & Attractions' : 'Mga Themed Garden at Atraksyon'}</h2>
        <p class="section-subheading mx-auto">
          {currentLang === 'en'
            ? 'Eight themed gardens showcasing international friendship, biodiversity, and Cordillera culture.'
            : 'Walong themed garden na nagpapakita ng internasyonal na pagkakaibigan, biodiversity, at kultura ng Cordillera.'}
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {ATTRACTIONS.map((attr) => (
          <div id={attr.id} class="card card-hover flex flex-col h-full overflow-hidden">
            <div class="bg-pine-50 p-6 py-8 flex items-center justify-center">
              <span class="text-5xl">{attr.icon}</span>
            </div>
            <div class="p-5 flex flex-col flex-1 gap-3">
              <div class="flex items-start justify-between gap-2">
                <h3 class="text-lg font-bold text-pine-950">
                  {currentLang === 'en' ? attr.titleEn : attr.titleFil}
                </h3>
                <span class="badge bg-rose-sand-50 text-rose-sand-700 text-[10px] shrink-0 mt-0.5">
                  {currentLang === 'en' ? attr.tagEn : attr.tagFil}
                </span>
              </div>
              <p class="text-sm text-cold-600 leading-relaxed">
                {currentLang === 'en' ? attr.descriptionEn : attr.descriptionFil}
              </p>
              <div class="mt-auto pt-3 border-t border-cold-100">
                <p class="text-xs font-semibold text-cold-400 uppercase tracking-wider mb-2">
                  {currentLang === 'en' ? 'Highlights' : 'Mga Dapat Makita'}
                </p>
                <ul class="space-y-1.5">
                  {(currentLang === 'en' ? attr.highlightsEn : attr.highlightsFil).map((h, i) => (
                    <li class="flex items-start gap-2 text-xs text-cold-600">
                      <svg class="h-3.5 w-3.5 text-pine-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg>
                      {h}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ======= GOOGLE MAPS REVIEWS SECTION ======= -->
  <section id="reviews" class="section-padding bg-white">
    <div class="container-page">
      <div class="text-center mb-10">
        <span class="badge bg-rose-sand-50 text-rose-sand-700 border border-rose-sand-200 mb-4">
          {isEn ? '⭐ Reviews' : '⭐ Mga Review'}
        </span>
        <h2 class="section-heading">{reviewsTitle}</h2>
        <p class="section-subheading mx-auto">
          {isEn
            ? `Ratings and reviews quoted from ${fullName} on Google Maps — shown here for reference only, with the source credited.`
            : `Rating at mga review na sipi mula sa ${fullName} sa Google Maps — ipinapakita dito bilang sanggunian lamang, na may nakalagay na pinagmulan.`}
        </p>
      </div>

      <!-- Rating summary -->
      <div class="max-w-3xl mx-auto card p-6 sm:p-8 mb-10">
        <div class="flex flex-col sm:flex-row items-center gap-6 sm:gap-10">
          <div class="text-center shrink-0">
            <p class="text-5xl sm:text-6xl font-extrabold text-pine-950 leading-none">
              {REVIEW_META.rating}
            </p>
            <div class="mt-2 flex items-center justify-center gap-0.5 text-rose-sand-500" aria-hidden="true">
              {Array.from({ length: 5 }).map(() => (
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              ))}
            </div>
            <p class="mt-2 text-sm text-cold-500">
              {isEn
                ? `${REVIEW_META.reviewCountLabel} Google Maps reviews`
                : `${REVIEW_META.reviewCountLabel} na review sa Google Maps`}
            </p>
          </div>
          <div class="flex-1 space-y-3 text-center sm:text-left">
            <p class="text-sm text-cold-600 leading-relaxed">
              {isEn
                ? `${fullName} (${cityName}) is rated ${REVIEW_META.rating} out of 5 by Google Maps users. The rating and review count below were synced in ${REVIEW_META.syncMonthEn} and may change over time — always check Google Maps for the latest figure.`
