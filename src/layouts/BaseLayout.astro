---
import { SITE, ENTITY, type FaqItem } from '../consts';
import { getLangFromUrl, languages, defaultLang, type Lang } from '../i18n/ui';
import BaseHead from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  lang?: string;
  canonical?: string;
  /** Low-value utility pages (legal, cookie) should stay out of the index. */
  noindex?: boolean;
  /** When provided, a FAQPage JSON-LD graph is emitted. Reviews are never emitted. */
  faqs?: FaqItem[];
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  lang: propLang,
  canonical: propCanonical,
  noindex = false,
  faqs,
} = Astro.props;

const currentUrl = new URL(Astro.url);
const currentLang = propLang ?? getLangFromUrl(currentUrl);
const pathname = currentUrl.pathname;
const isEn = currentLang === 'en';

const altLinks = Object.entries(languages).map(([code]) => {
  let altPath = pathname;
  for (const lc of [defaultLang, ...Object.keys(languages)]) {
    if (pathname.startsWith(`/${lc}/`)) {
      altPath = pathname.replace(`/${lc}/`, `/${code}/`);
    } else if (pathname === `/${lc}`) {
      altPath = `/${code}`;
    } else if (pathname === '' || pathname === '/') {
      altPath = `/${code}`;
    }
  }
  return { code, href: altPath };
});

const resolvedDescription = description ?? (isEn ? SITE.descriptionEn : SITE.descriptionFil);
const resolvedTitle = title ?? (isEn ? SITE.titleEn : SITE.titleFil);
const resolvedOgTitle = ogTitle ?? resolvedTitle;
const resolvedOgDescription = ogDescription ?? resolvedDescription;
const siteUrl = SITE.siteUrl;
const canonicalUrl = propCanonical ?? (siteUrl + (pathname.endsWith('/') ? pathname : pathname + '/'));
const ogImageUrl = ogImage ?? `${siteUrl}${SITE.heroImage}`;

const countryName = isEn ? ENTITY.country : ENTITY.countryFil;
const shortNameEn = ENTITY.shortName;

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${siteUrl}/#attraction`,
  name: ENTITY.fullName,
  alternateName: [
    shortNameEn,
    `${shortNameEn} ${ENTITY.city}`,
    `${ENTITY.fullName}, ${ENTITY.cityLong}, ${ENTITY.province}`,
  ],
  description: isEn
    ? `Comprehensive visitor guide to ${ENTITY.fullName} in ${ENTITY.cityLong}, ${ENTITY.province}, ${ENTITY.country}.`
    : `Komprehensibong gabay sa pagbisita sa ${ENTITY.fullName} sa ${ENTITY.cityLong}, ${ENTITY.province}, ${countryName}.`,
  url: canonicalUrl,
  image: [
    `${siteUrl}/gallery/baguio-botanical-garden-1.jpg`,
    `${siteUrl}/gallery/baguio-botanical-garden-2.jpg`,
    `${siteUrl}/gallery/baguio-botanical-garden-3.jpg`,
  ],
  publicAccess: true,
  isAccessibleForFree: false,
  additionalProperty: [
    {
      '@type': 'PropertyValue',
      name: isEn ? 'Adult entrance fee' : 'Bayad sa pagpasok (matanda)',
      value: 'PHP 100',
    },
    {
      '@type': 'PropertyValue',
      name: isEn ? 'Child, student & senior citizen entrance fee' : 'Bayad sa pagpasok (bata, estudyante, senior)',
      value: 'PHP 50',
    },
    {
      '@type': 'PropertyValue',
      name: isEn ? 'Entrance fee for children 3 years old and below' : 'Bayad sa pagpasok (3 taong gulang pababa)',
      value: 'PHP 0',
    },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: isEn ? SITE.addressEn : SITE.addressFil,
    addressLocality: ENTITY.cityLong,
    addressRegion: ENTITY.province,
    postalCode: ENTITY.postalCode,
    addressCountry: ENTITY.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: ENTITY.latitude,
    longitude: ENTITY.longitude,
  },
  hasMap: ENTITY.mapsShareUrl,
  telephone: SITE.phone,
  sameAs: [ENTITY.mapsShareUrl, ENTITY.govtTourismUrl, ENTITY.dotUrl],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '06:00',
    closes: '18:00',
  },
  touristType: ['Nature Lovers', 'Culture Enthusiasts', 'Families', 'Photographers'],
  containedInPlace: {
    '@type': 'City',
    name: ENTITY.cityLong,
    address: {
      '@type': 'PostalAddress',
      addressLocality: ENTITY.cityLong,
      addressRegion: ENTITY.province,
      postalCode: ENTITY.postalCode,
      addressCountry: ENTITY.countryCode,
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${siteUrl}/#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: isEn ? 'Home' : 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: countryName },
    { '@type': 'ListItem', position: 3, name: ENTITY.province },
    { '@type': 'ListItem', position: 4, name: ENTITY.cityLong },
    { '@type': 'ListItem', position: 5, name: ENTITY.fullName, item: canonicalUrl },
  ],
};

const faqSchema = faqs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      '@id': `${siteUrl}/#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: isEn ? faq.qEn : faq.qFil,
        acceptedAnswer: {
          '@type': 'Answer',
          text: isEn ? faq.aEn : faq.aFil,
        },
      })),
    }
  : null;

const graph = [attractionSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<!DOCTYPE html>
<html lang={isEn ? 'en' : 'tl'}>
  <head>
    <BaseHead
      title={resolvedTitle}
      description={resolvedDescription}
      ogTitle={resolvedOgTitle}
      ogDescription={resolvedOgDescription}
      ogImage={ogImageUrl}
      ogImageAlt={`${ENTITY.fullName} in ${ENTITY.city}, ${countryName}`}
      canonical={canonicalUrl}
      lang={currentLang as Lang}
      noindex={noindex}
    />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}></script>

    <!-- Alternate hreflang tags -->
    {altLinks.map(({ code, href }) => (
      <link rel="alternate" hreflang={code === 'tl' ? 'tl' : 'en'} href={`${siteUrl}${href}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${altLinks.find(a => a.code === defaultLang)?.href ?? '/tl'}`} />
  </head>
  <body class="font-sans text-cold-800 bg-cold-50 antialiased">
    <Navbar lang={currentLang as Lang} currentPath={pathname} />
    <main>
      <slot />
    </main>
    <Footer lang={currentLang as Lang} />
    <script>
      if ('serviceWorker' in navigator && window.location.protocol === 'https:') {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
