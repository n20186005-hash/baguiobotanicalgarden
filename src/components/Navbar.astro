---
import { SITE, NAV } from '../consts';
import { ui, type Lang } from '../i18n/ui';

export interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const t = (key: string) => ui[lang]?.[key as keyof typeof ui.tl] ?? key;

const navItems = [
  { id: 'about', label: t('nav_about') },
  { id: 'attractions', label: t('nav_attractions') },
  { id: 'practical', label: t('nav_practical') },
  { id: 'transport', label: t('nav_transport') },
  { id: 'gallery', label: t('nav_gallery') },
  { id: 'tips', label: t('nav_tips') },
  { id: 'faq', label: t('nav_faq') },
];

const otherLang = lang === 'tl' ? 'en' : 'tl';
const otherLangPath = `/${otherLang}/`;
const currentLangPath = `/${lang}/`;

function isActive(id: string) {
  // All section anchoring is on the main index page
  return false;
}
---

<header class="sticky top-0 z-50 bg-white/85 backdrop-blur-md border-b border-cold-100 shadow-sm">
  <nav class="container-page flex items-center justify-between py-3 sm:py-4" aria-label="Main navigation">
    <a href={currentLangPath} class="flex items-center gap-2.5 group shrink-0">
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-pine-600 text-white text-lg shadow-sm">🌿</span>
      <span class="text-sm sm:text-base font-bold text-pine-950 leading-tight group-hover:text-pine-700 transition-colors max-[380px]:text-xs">
        {t('siteName')}
      </span>
    </a>

    <div class="flex items-center gap-3 sm:gap-4">
      <div class="hidden lg:flex items-center gap-1 flex-wrap">
        {navItems.map(item => (
          <a href={`${currentLangPath}#${item.id}`} class="nav-link text-[13px] font-medium text-cold-600 hover:text-pine-700 px-2.5 py-1.5 rounded-lg transition-colors">
            {item.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-2">
        <a
          href={otherLangPath}
          class="inline-flex items-center gap-1 rounded-full border border-cold-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-pine-700 hover:bg-pine-50 hover:border-pine-300 transition-colors shrink-0"
          title={lang === 'tl' ? 'Switch to English' : 'Lumipat sa Tagalog'}
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
          <span>{otherLang.toUpperCase()}</span>
        </a>

        <!-- Mobile menu trigger -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden inline-flex items-center justify-center h-9 w-9 rounded-lg border border-cold-200 bg-white text-cold-600 hover:bg-cold-50 transition-colors"
          aria-label="Menu"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-cold-100 bg-white/95 backdrop-blur-md px-4 py-3 space-y-1">
    {navItems.map(item => (
      <a
        href={`${currentLangPath}#${item.id}`}
        class="mobile-nav-link block text-sm font-medium text-cold-700 hover:text-pine-700 hover:bg-pine-50 px-3 py-2 rounded-lg transition-colors"
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
    });
  });
</script>
