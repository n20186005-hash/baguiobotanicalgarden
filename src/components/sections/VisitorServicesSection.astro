---
import { VISITOR_SERVICES, ENTITY } from '../../consts';

export interface Props {
  lang: 'tl' | 'en';
}

const { lang } = Astro.props;
const isEn = lang === 'en';

const t = {
  badge: isEn ? '🛎️ Services' : '🛎️ Mga Pasilidad',
  title: isEn ? 'Visitor Services & Surrounding Facilities' : 'Mga Pasilidad at Serbisyo para sa Bisita',
  subtitle: isEn
    ? `What to expect at ${ENTITY.fullName} and in the immediate surroundings — described by facility type so you can plan without depending on any single business.`
    : `Ano ang aasahan sa ${ENTITY.fullName} at sa agarang paligid — inilalarawan ayon sa uri ng pasilidad upang makapagplano nang hindi nakadepende sa iisang negosyo.`,
  neutral: isEn
    ? 'This guide is independent and non-commercial: facility types and distances are described without promoting any specific brand or merchant.'
    : 'Ang gabay na ito ay independyente at hindi pangkomersyo: ang mga uri ng pasilidad at distansya ay inilalarawan nang walang itinataguyod na partikular na brand o negosyante.',
};
---

<section id="services" class="section-padding bg-white">
  <div class="container-page">
    <div class="text-center mb-10">
      <span class="badge bg-sky-50 text-sky-700 border border-sky-200 mb-4">{t.badge}</span>
      <h2 class="section-heading">{t.title}</h2>
      <p class="section-subheading mx-auto">{t.subtitle}</p>
      <p class="mt-3 text-xs text-cold-500 max-w-3xl mx-auto">{t.neutral}</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {VISITOR_SERVICES.map((service) => (
        <article class="card card-hover p-5 flex flex-col">
          <div class="flex items-center gap-2.5 mb-3">
            <span class="text-2xl" aria-hidden="true">{service.icon}</span>
            <h3 class="text-sm font-bold text-pine-950 leading-tight">
              {isEn ? service.titleEn : service.titleFil}
            </h3>
          </div>
          <p class="text-xs text-cold-600 leading-relaxed">
            {isEn ? service.descriptionEn : service.descriptionFil}
          </p>
          <ul class="mt-4 space-y-2 pt-4 border-t border-cold-100">
            {(isEn ? service.pointsEn : service.pointsFil).map((point) => (
              <li class="flex gap-2 text-xs text-cold-600 leading-relaxed">
                <span class="text-pine-500 font-bold">•</span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
