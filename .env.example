# ===== Baguio Botanical Garden · Environment Variables (TEMPLATE) =====
# Copy this file to `.env` and fill in values.
# Keys prefixed with PUBLIC_ are accessible from browser/client-side code.

# Full site URL — used for canonical, OG, and sitemap
PUBLIC_SITE_URL=https://baguiobotanicalgarden.com

# Site name
PUBLIC_SITE_NAME=Baguio Botanical Garden

# Google Analytics 4 Measurement ID
PUBLIC_GA4_ID=G-YJTNXGWZNY
